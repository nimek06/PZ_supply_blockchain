# Wszystkie zmienne VITE_* trafiają do przeglądarki. Żadnych kluczy ani tokenów.
# Puste = wartości domyślne dla lokalnego stacku z infrastructure/local.

# cele proxy serwera Vite (zostają na komputerze, nie trafiają do przeglądarki)
BACKEND_URL=http://localhost:8080
ANVIL_URL=http://127.0.0.1:8545
IPFS_GATEWAY_URL=http://127.0.0.1:8081

# adresy widziane z przeglądarki; domyślnie ścieżki proxy, więc działają też z telefonu
VITE_RPC_URL=/rpc
VITE_IPFS_GATEWAY_URL=/ipfs
VITE_CHAIN_ID=31337
VITE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
