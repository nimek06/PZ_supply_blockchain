# Skopiuj do infrastructure/local/.env (jest w .gitignore), tu nie wpisuj prawdziwych sekretów.
# Poza POSTGRES_PASSWORD wszystko ma domyślne wartości w compose.yaml.

# PostgreSQL
POSTGRES_DB=supplychain
POSTGRES_USER=supplychain
# wymagane, np. `openssl rand -hex 16`
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Anvil. Zmiana chainId = nowy deploy i nowy wektor podpisów.
ANVIL_CHAIN_ID=31337
ANVIL_PORT=8545

# Kubo. Gateway na 8081, bo 8080 ma backend.
KUBO_API_PORT=5001
KUBO_GATEWAY_PORT=8081
