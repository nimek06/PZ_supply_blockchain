# Skopiuj do infrastructure/local/.env (plik jest w .gitignore). NIE wpisuj tu prawdziwych sekretów.
# Wszystkie wartości poza POSTGRES_PASSWORD mają sensowne domyślne w compose.yaml.

# PostgreSQL
POSTGRES_DB=supplychain
POSTGRES_USER=supplychain
# Wymagane - puste hasło przerywa `docker compose up`. Wymyśl lokalne hasło, np. `openssl rand -hex 16`.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Anvil (lokalny łańcuch). 31337 = domyślny chainId; zmiana wymaga nowego wdrożenia i nowego wektora podpisów.
ANVIL_CHAIN_ID=31337
ANVIL_PORT=8545

# Kubo (lokalny IPFS). Brama na 8081, bo 8080 zajmuje backend.
KUBO_API_PORT=5001
KUBO_GATEWAY_PORT=8081
