# Zmienne dla skryptów Forge (contracts/script). Skopiuj do contracts/.env (poza Git)
# i uzupełnij lokalnie. Nigdy nie commituj prawdziwych kluczy ani URL RPC z tokenem.

# Publiczny RPC Amoy (sprawdzone w tyg. 1: publicnode, tenderly; drpc free odrzuca getLogs)
AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com

# DeploySupplyChain.s.sol
DEPLOYER_PRIVATE_KEY=
EXPECTED_CHAIN_ID=80002
RELAYER_ADDRESS=
QA_INSPECTOR_ADDRESS=
ADMIN_ADDRESS=
MAX_DEADLINE_WINDOW=3600

# RegisterStation.s.sol
ADMIN_PRIVATE_KEY=
SUPPLY_CHAIN_ADDRESS=
STATION_ADDRESS=
STATION_ID=
STATION_EXPIRES_AT=
STATION_STAGE_MASK=15

# SmokeStage.s.sol (klucz stacji wyłącznie testowy, bez środków)
RELAYER_PRIVATE_KEY=
STATION_PRIVATE_KEY=
BATCH_NUMBER=B-2026-0001
DEADLINE_SECONDS=900
